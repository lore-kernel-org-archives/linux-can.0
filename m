>  		cf->can_id |=3D CAN_ERR_CRTL;
>  		cf->data[1] =3D CAN_ERR_CRTL_RX_OVERFLOW;
> +		stats->rx_over_errors++;
>  		stats->rx_errors++;
> -		stats->rx_bytes +=3D cf->can_dlc;
>  		netif_rx(skb);
